{
  "provider": "gmail",
  "forms": {
    "default": {
      "EMAIL_FIELD": "deployment_details/EMAIL_FIELD",
      "from_name": "Survey team",
      "subject": "Thank you $deployee_name - copy of your submission",
      "title": "Thank you, $deployee_name!",
      "intro": "We have received your answers. Here is a copy for your records.",
      "brand_color": "#2b6cb0",
      "logo_url": "",
      "include": ["*"],
      "exclude": ["_*", "meta/*", "formhub/*", "start", "end", "contact/email", "consent"],
      "labels": {
        "contact": "Your details",
        "deployment_details/deployee_name": "Full name",
        "deployment_overview/thematic_focus_primary":"1. What is your deployment’s primary thematic focus area?",
        "deployment_overview/_3_Institutional_Cap_eployment_supporting":"3. Institutional Capability: What response phase is your deployment supporting?"
      },
      "value_labels": {
        "gender": {"f": "Female", "m": "Male", "o": "Other"},
        "services_used": {"water": "Water point", "health": "Health clinic", "school": "School"},
        "satisfaction": {"1": "Very unsatisfied", "2": "Unsatisfied", "3": "Neutral", "4": "Satisfied", "5": "Very satisfied"},
        "deployment_overview/_3_Institutional_Cap_eployment_supporting":{"preparednes": "Preparedness", "response":"Response","recovery":"Recovery"},
        "deployment_overview/thematic_focus_primary":{"gedsi":"GEDSI","protection":"Protection","drm":"Disaster Risk Management"}
      },
      "hide_empty": false,
      "group_headers": true,
      "pdf": true,
      "pdf_title": "Copy of your submission ($deployment_details/deployee_name)",
      "pdf_filename": "submission-$submission_id.pdf"
    }
  }
}
